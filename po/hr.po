#: data/io.github.fabrialberio.pinapp.desktop.in:3
#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:9
msgid "Create and edit app shortcuts"
msgstr "Stvori i uredi prečace aplikacija"

#: data/io.github.fabrialberio.pinapp.desktop.in:10
msgid "GNOME;GTK;Apps;Shortcuts;Icons;"
msgstr "GNOME;GTK;Aplikacije;Prečaci;Ikone;"

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:15
msgid "Pins allows you to customize your app menu by editing .desktop files."
msgstr ""
"Pins omogućuje prilagodbu izbornika aplikacija uređivanjem .desktop datoteka."

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:16
msgid "Some of the things you can do are:"
msgstr "Neke od stvari koje se mogu raditi:"

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:18
msgid "changing an app icon that doesn't fit in with your theme,"
msgstr "mijenjanje ikone aplikacije koja ne odgovara tvojoj temi,"

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:19
msgid "creating custom shortcuts to websites,"
msgstr "izrada prilagođenih prečaca za web-stranice,"

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:20
msgid "hiding apps you don't want to see,"
msgstr "skrivanje aplikacija koje ne želiš vidjeti,"

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:21
msgid "editing properties in .desktop files."
msgstr "uređivanje svojstava u .desktop datotekama."

#: data/io.github.fabrialberio.pinapp.metainfo.xml.in:33
